// Settings for Cloudflare: publish the built site in _site as static files.
// workers_dev stays on so the workers.dev address keeps working beside the custom domain.
// preview_urls is left unset so an existing preview setting is not changed.
{
  "name": "spookybaron-site",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "spookybaron.co.uk", "custom_domain": true },
    { "pattern": "www.spookybaron.co.uk", "custom_domain": true }
  ],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
