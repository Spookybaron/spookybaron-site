---
layout: base.njk
title: Journal
eleventyExcludeFromCollections: true
---
<h1>Journal</h1>
<ul class="entries">
  {%- for post in collections.journal | reverse %}
    <li><a href="{{ post.url }}">{{ post.data.title }}{% if post.data.type == "weekly" %} <span class="kind">Weekly</span>{% endif %}</a> <time>{{ post.date | niceDate }}</time></li>
  {%- endfor %}
</ul>
