---
permalink: /journal/feed.xml
eleventyExcludeFromCollections: true
layout: false
tags: []
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Spooky Baron's What's New</title>
  <id>urn:spookybaron:journal</id>
  <link rel="alternate" type="text/html" href="{{ site.url }}/journal/"/>
  <link rel="self" type="application/atom+xml" href="{{ site.url }}/journal/feed.xml"/>
  {%- set latest = collections.journal | last %}
  <updated>{{ (latest.date if latest else page.date) | isoDate }}</updated>
  {%- for post in collections.journal | reverse %}
  <entry>
    <title>{{ post.data.title | escape }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>urn:spookybaron:journal:{{ post.fileSlug }}</id>
    <updated>{{ post.date | isoDate }}</updated>
    <content type="html">{{ post.content | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
