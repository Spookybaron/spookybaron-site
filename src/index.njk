---
layout: base.njk
description: Luke (Spookybaron), a UK creator. Games, videos, and a journal about making them.
---
<section class="hero">
  <p class="kicker">UK creator</p>
  <h1>
    <span class="intro-line">I’m Luke.</span>
    <span class="brand-line">Spookybaron</span>
  </h1>
  <p class="lede">I make small games, film ordinary days, and write down how the work gets done. Games, videos, a journal — all in one place.</p>
  <div class="hero-actions">
    <a class="btn" href="/games/">Play a game</a>
    <a class="btn btn-ghost" href="/videos/">Watch the videos</a>
  </div>
</section>

<ul class="bento">
  <li class="bento-games">
    <a href="/games/">
      <p class="kicker">Play</p>
      <strong>Games</strong>
      <span class="blurb">Four browser games. A flat scrap, a neon snake, falling letters, and a helpdesk under siege.</span>
      <ul class="chips">
        {%- for game in games %}
        <li{% if game.image %} class="has-shot" style="--shot: url('{{ game.image }}')"{% endif %}>{{ game.title }}</li>
        {%- endfor %}
      </ul>
      <span class="go">Enter the arcade</span>
    </a>
  </li>
  <li class="bento-journal">
    <a href="/journal/">
      <p class="kicker">Read</p>
      <strong>Journal</strong>
      <span class="blurb">Notes from making the games and the videos, including the quiet weeks.</span>
      {%- set latestPosts = collections.journal | reverse | head(1) %}
      {%- if latestPosts | length %}
      <span class="peek">Latest: {{ latestPosts[0].data.title }}</span>
      {%- endif %}
      <span class="go">All entries</span>
    </a>
  </li>
  <li class="bento-videos">
    <a href="/videos/">
      <p class="kicker">Watch</p>
      <strong>Videos</strong>
      <span class="blurb">Both channels in one place: cartoons, gaming, days out and things made at home.</span>
      {%- set newest = youtube.channels | latestFrom(["spooky", "life"]) %}
      {%- if newest | length %}
      <span class="peek">Latest: {{ newest[0].title }}</span>
      {%- endif %}
      <span class="go">Watch here</span>
    </a>
  </li>
  <li class="bento-social">
    <a href="/social/">
      <p class="kicker">Elsewhere</p>
      <strong>Social</strong>
      <span class="blurb">YouTube, TikTok, Twitch and X. Each one shown the way that platform works best.</span>
      <span class="go">Find the channels</span>
    </a>
  </li>
</ul>

<section class="band">
  <div class="band-head">
    <h2>In the arcade</h2>
    <a href="/games/">All games</a>
  </div>
  <ul class="game-grid">
    {%- for game in games %}
    <li>
      <a href="{{ game.href }}"{% if game.image %} class="has-shot" style="--shot: url('{{ game.image }}')"{% endif %}>
        <strong>{{ game.title }}</strong>
        <span>{{ game.text }}</span>
      </a>
    </li>
    {%- endfor %}
  </ul>
</section>

<section class="band">
  <div class="band-head">
    <h2>From the journal</h2>
    <a href="/journal/">All entries</a>
  </div>
  <ul class="entries">
    {%- for post in collections.journal | reverse | head(5) %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}{% if post.data.type == "weekly" %} <span class="kind">Weekly</span>{% endif %}</a>
      <time datetime="{{ post.date | isoDate }}">{{ post.date | niceDate }}</time>
    </li>
    {%- endfor %}
  </ul>
</section>
