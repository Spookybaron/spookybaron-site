---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- set newest = collections.journal | last %}
  <url><loc>{{ site.url }}/</loc>{% if newest %}<lastmod>{{ newest.date | dateOnly }}</lastmod>{% endif %}</url>
  <url><loc>{{ site.url }}/games/</loc></url>
  <url><loc>{{ site.url }}/journal/</loc>{% if newest %}<lastmod>{{ newest.date | dateOnly }}</lastmod>{% endif %}</url>
  <url><loc>{{ site.url }}/videos/</loc></url>
  <url><loc>{{ site.url }}/social/</loc></url>
  {%- for game in games %}
  <url><loc>{{ site.url }}{{ game.href }}</loc></url>
  {%- endfor %}
  {%- for post in collections.journal %}
  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | dateOnly }}</lastmod></url>
  {%- endfor %}
</urlset>
